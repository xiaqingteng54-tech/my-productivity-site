(function(){
  /* 相对链接：以 static/dashboard.html 为基准，逐段转小写并编码 */
  document.querySelectorAll('a[data-path]').forEach(function(a){
    var segs = a.getAttribute('data-path').split('/').map(function(s){
      return encodeURIComponent(s.toLowerCase());
    });
    a.setAttribute('href','../' + segs.join('/'));
  });

  /* 进度条：进入视口后填充 */
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var bars = [].slice.call(document.querySelectorAll('.bar'));
  function fill(b){ var p = b.getAttribute('data-pct') || '0'; b.querySelector('span').style.width = p + '%'; }
  if (reduce || !('IntersectionObserver' in window)) {
    bars.forEach(fill);
  } else {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting){ fill(e.target); io.unobserve(e.target); }
      });
    }, {threshold:.4});
    bars.forEach(function(b){ io.observe(b); });
  }
})();
</script>
</body>
</html>
