<script>
(function(){
  var KEY = 'ws-tasks-2026w45';

  var TASKS = [
    {id:'t1', title:'初步形成反洗钱合规管控建议', proj:'英国二手收藏品 AML', due:'2026-11-02', dueLabel:'今天到期', hot:true, state:'todo'},
    {id:'t2', title:'制裁法规更新', proj:'韩国制裁法规检索', due:'2026-11-09', dueLabel:'7 天后', hot:false, state:'todo'},
    {id:'t4', title:'报告 v2 五项待核收口', proj:'韩国制裁法规检索', due:'', dueLabel:'无期限', hot:false, state:'todo'},
    {id:'t3', title:'AMP 资质要求评估', proj:'英国二手收藏品 AML', due:'', dueLabel:'等治理侧结论', hot:false, state:'block'}
  ];

  var DONE = [
    {id:'d1', title:'报告 v2 修订完成', sub:'8 类法律抓手 · 13 条遗漏项 · 3 处修正', date:'11-02'},
    {id:'d2', title:'报告 v1 初版完成', sub:'伊朗纺织品 + 朝鲜连结点', date:'11-02'},
    {id:'d3', title:'Quartz 站点发布上线', sub:'GitHub Pages 已生效', date:'11-02'},
    {id:'d4', title:'PARA 骨架与首页 Dashboard', sub:'6 个分区 + Dataview 首页', date:'11-01'},
    {id:'d5', title:'每周复盘模板', sub:'5-System / Templater 变量', date:'11-01'}
  ];

  function load(){
    try{
      var raw = localStorage.getItem(KEY);
      if(raw) return JSON.parse(raw);
    }catch(e){}
    return {};
  }
  function save(s){
    try{ localStorage.setItem(KEY, JSON.stringify(s)); }catch(e){}
  }

  var stateStore = load();

  function isDone(t){
    if(stateStore[t.id] === true) return true;
    if(stateStore[t.id] === false) return false;
    return false;
  }

  function esc(s){
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  var CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>';

  function taskHTML(t){
    var pills = '';
    if(t.dueLabel){
      var cls = t.hot ? 'hot' : (t.state === 'block' ? 'wait' : '');
      pills += '<span class="pill ' + cls + '">' + esc(t.dueLabel) + '</span>';
    }
    if(t.proj) pills += '<span style="color:var(--ink-3)">' + esc(t.proj) + '</span>';
    return '<div class="task" data-id="' + t.id + '">' +
      '<div class="ck" role="checkbox" tabindex="0" aria-checked="false">' + CHECK + '</div>' +
      '<div style="flex:1;min-width:0">' +
        '<div class="t-title">' + esc(t.title) + '</div>' +
        '<div class="t-sub">' + pills + '</div>' +
      '</div></div>';
  }

  function doneHTML(d, undo){
    var attr = (undo && d.id) ? ' data-id="' + d.id + '"' : '';
    var tip = (undo && d.id) ? ' title="点击可撤销"' : '';
    return '<div class="task done"' + attr + tip + '><div class="ck">' + CHECK + '</div>' +
      '<div style="flex:1;min-width:0"><div class="t-title">' + esc(d.title) + '</div>' +
      '<div class="t-sub"><span style="color:var(--ink-3)">' + esc(d.sub) + '</span>' +
      '<span class="pill ok mono">' + esc(d.date) + '</span></div></div></div>';
  }

  function render(){
    var todoArr = [], blockArr = [];
    TASKS.forEach(function(t){
      if(isDone(t)) return;
      if(t.state === 'block') blockArr.push(t); else todoArr.push(t);
    });

    var doneExtra = TASKS.filter(function(t){ return isDone(t); }).map(function(t){
      return {title:t.title, sub:'刚刚勾选完成 · ' + (t.proj || ''), date:'已完成'};
    });

    var todoList = document.getElementById('listTodo');
    var blockList = document.getElementById('listBlock');
    var doneList = document.getElementById('listDone');

    todoList.innerHTML = todoArr.length
      ? todoArr.map(taskHTML).join('')
      : '<div style="padding:22px 14px;font-size:12.5px;color:var(--ink-3);text-align:center;">待办已清空</div>';
    blockList.innerHTML = blockArr.length
      ? blockArr.map(taskHTML).join('')
      : '<div style="padding:22px 14px;font-size:12.5px;color:var(--ink-3);text-align:center;">没有受阻项</div>';
    doneList.innerHTML = doneExtra.map(function(d){ return doneHTML(d, true); }).join('') +
      DONE.map(function(d){ return doneHTML(d, false); }).join('');

    document.getElementById('cTodo').textContent = todoArr.length;
    document.getElementById('cBlock').textContent = blockArr.length;
    document.getElementById('cDone').textContent = doneExtra.length + DONE.length;

    var open = todoArr.length + blockArr.length;
    var doneCount = doneExtra.length + DONE.length;
    document.getElementById('mOpen').innerHTML = open + '<small>项</small>';
    document.getElementById('mDone').innerHTML = doneCount + '<small>项</small>';
    var total = open + doneCount;
    var rate = total === 0 ? 0 : Math.round(doneCount / total * 1000) / 10;
    document.getElementById('mRate').innerHTML = rate + '<small>%</small>';
  }

  document.addEventListener('click', function(e){
    var el = e.target;
    var ck = el && el.closest ? el.closest('.ck') : null;
    if(!ck) return;
    var row = ck.closest('.task');
    if(!row || !row.dataset.id) return;
    var id = row.dataset.id;
    stateStore[id] = !(stateStore[id] === true);
    save(stateStore);
    row.classList.toggle('done');
    ck.setAttribute('aria-checked', row.classList.contains('done') ? 'true' : 'false');
    setTimeout(render, 260);
  });

  document.addEventListener('keydown', function(e){
    if(e.key !== 'Enter' && e.key !== ' ') return;
    var ck = document.activeElement;
    if(ck && ck.classList && ck.classList.contains('ck')){ e.preventDefault(); ck.click(); }
  });

  render();

  setTimeout(function(){
    var bar = document.getElementById('projBar');
    if(bar) bar.style.width = '60%';
  }, 500);

  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting){
          en.target.style.opacity = '1';
          en.target.style.transform = 'none';
          io.unobserve(en.target);
        }
      });
    }, {threshold: 0.1});
    var els = document.querySelectorAll('.col, .proj, .verify, .kcell');
    for(var i=0;i<els.length;i++){
      var el = els[i];
      el.style.transition = 'opacity .6s ease, transform .6s cubic-bezier(.2,.7,.25,1)';
      el.style.opacity = '0';
      el.style.transform = 'translateY(12px)';
      io.observe(el);
    }
  }

  function fix(){
    var kb = document.querySelector('.kb-two');
    if(kb) kb.style.gridTemplateColumns = window.innerWidth < 900 ? '1fr' : '1.15fr .85fr';
    var pf = document.querySelector('.proj-facts');
    if(pf) pf.style.gridTemplateColumns = window.innerWidth < 700 ? '1fr' : 'repeat(3,1fr)';
  }
  window.addEventListener('resize', fix);
  fix();
})();
</script>
</body>
</html>
