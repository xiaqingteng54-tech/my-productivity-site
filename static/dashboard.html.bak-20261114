<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>我的工作台</title>
<style>
  :root{
    --bg:#faf8f4; --card:#ffffff; --ink:#23201c; --sub:#7a7169;
    --line:#e9e3d9; --accent:#c05621; --accent-soft:#fdf1e7;
    --danger:#b4342a; --danger-soft:#fdeceb; --ok:#3f7d4e; --ok-soft:#eef6f0;
    --radius:14px;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#171614; --card:#211f1c; --ink:#eee8dd; --sub:#a49b8f;
      --line:#332f2a; --accent:#e08a4f; --accent-soft:#2c231b;
      --danger:#e07b70; --danger-soft:#2e1e1c; --ok:#7bb78b; --ok-soft:#1e2a21;
    }
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--bg); color:var(--ink);
    font:16px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1080px;margin:0 auto;padding:40px 22px 80px}
  header.top{margin-bottom:28px}
  .h-row{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap}
  h1{font-size:30px;margin:0;letter-spacing:-.02em;font-weight:700}
  .date{color:var(--sub);font-size:14px;letter-spacing:.04em}
  .chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
  .chip{
    background:var(--card);border:1px solid var(--line);border-radius:999px;
    padding:6px 14px;font-size:13px;color:var(--sub);display:flex;gap:8px;align-items:center
  }
  .chip b{color:var(--ink);font-size:15px;font-weight:650}
  .chip.warn{border-color:var(--danger);color:var(--danger);background:var(--danger-soft)}
  .chip.warn b{color:var(--danger)}
  section{margin:34px 0 0}
  .sec-h{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  .sec-h .num{
    width:22px;height:22px;border-radius:7px;background:var(--accent-soft);color:var(--accent);
    font-size:12px;font-weight:700;display:grid;place-items:center;flex:none
  }
  .sec-h h2{font-size:16px;margin:0;font-weight:650;letter-spacing:.01em}
  .sec-h .count{color:var(--sub);font-size:13px;font-weight:400}
  .sec-h .hint{margin-left:auto;color:var(--sub);font-size:12px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:6px 4px}
  ul.list{list-style:none;margin:0;padding:0}
  ul.list li{display:flex;gap:12px;align-items:flex-start;padding:11px 16px;border-bottom:1px solid var(--line)}
  ul.list li:last-child{border-bottom:0}
  .box{
    width:15px;height:15px;border:1.6px solid var(--line);border-radius:4px;flex:none;margin-top:4px
  }
  .box.over{border-color:var(--danger);background:var(--danger-soft)}
  .t-main{flex:1;min-width:0}
  .t-text{display:block;word-break:break-word}
  .t-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:3px;font-size:12px;color:var(--sub)}
  .badge{font-size:11px;padding:1px 7px;border-radius:999px;border:1px solid var(--line)}
  .badge.due{color:var(--accent);border-color:var(--accent);background:var(--accent-soft)}
  .badge.over{color:var(--danger);border-color:var(--danger);background:var(--danger-soft)}
  .badge.src{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .empty{padding:20px 18px;color:var(--sub);font-size:14px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(258px,1fr));gap:14px}
  .proj{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 16px 14px}
  .proj .p-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
  .proj .p-name{font-weight:640;font-size:15px;line-height:1.4}
  .status{font-size:11px;padding:2px 9px;border-radius:999px;border:1px solid var(--line);color:var(--sub);flex:none}
  .status.run{color:var(--accent);border-color:var(--accent);background:var(--accent-soft)}
  .status.done{color:var(--ok);border-color:var(--ok);background:var(--ok-soft)}
  .status.pause{color:var(--sub)}
  .bar{height:5px;border-radius:3px;background:var(--line);margin:14px 0 8px;overflow:hidden}
  .bar span{display:block;height:100%;background:var(--accent);border-radius:3px}
  .p-foot{display:flex;justify-content:space-between;font-size:12px;color:var(--sub)}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  @media (max-width:760px){.two{grid-template-columns:1fr}.wrap{padding:26px 16px 60px}h1{font-size:24px}}
  .search{
    width:100%;padding:10px 14px;border-radius:10px;border:1px solid var(--line);
    background:var(--card);color:var(--ink);font-size:14px;outline:none;margin-bottom:12px
  }
  .search:focus{border-color:var(--accent)}
  .folder{margin-bottom:14px}
  .folder>h3{margin:0 0 6px;font-size:13px;color:var(--sub);font-weight:600;letter-spacing:.03em}
  .folder ul{list-style:none;margin:0;padding:0}
  .folder li{padding:5px 0;font-size:14px;display:flex;gap:8px;align-items:baseline;border-bottom:1px dashed var(--line)}
  .folder li:last-child{border-bottom:0}
  .folder li a:hover{color:var(--accent)}
  .folder .mini{color:var(--sub);font-size:11px;margin-left:auto;flex:none}
  .tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:4px}
  .tag{font-size:12px;padding:3px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent);border:0;cursor:pointer}
  .tag.off{background:transparent;border:1px solid var(--line);color:var(--sub)}
  details.group{border-bottom:1px solid var(--line)}
  details.group:last-child{border-bottom:0}
  details.group summary{
    cursor:pointer;padding:12px 16px;font-size:14px;display:flex;gap:10px;align-items:center;list-style:none
  }
  details.group summary::-webkit-details-marker{display:none}
  details.group summary::before{content:"▸";color:var(--sub);font-size:11px;transition:.15s}
  details.group[open] summary::before{transform:rotate(90deg)}
  details.group summary .g-name{font-weight:600}
  details.group summary .g-count{margin-left:auto;color:var(--sub);font-size:12px}
  details.group ul.list li{border-bottom:1px dashed var(--line)}
  footer{margin-top:46px;padding-top:18px;border-top:1px solid var(--line);color:var(--sub);font-size:12px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .health{border:1px dashed var(--accent);border-radius:10px;padding:12px 16px;font-size:13px;color:var(--sub);background:var(--accent-soft)}
  .health b{color:var(--ink)}
  .health code{font-size:12px;background:var(--card);padding:1px 5px;border-radius:4px}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="h-row">
      <h1>我的工作台</h1>
      <div class="date" id="today-label"></div>
    </div>
    <div class="chips" id="chips"></div>
  </header>

  <section id="sec-today">
    <div class="sec-h"><span class="num">1</span><h2>今日待办</h2><span class="count" id="today-count"></span><span class="hint">今天到期 + 已逾期</span></div>
    <div class="card" id="today-list"></div>
  </section>

  <section id="sec-proj">
    <div class="sec-h"><span class="num">2</span><h2>项目看板</h2><span class="count" id="proj-count"></span><span class="hint">进度自动统计</span></div>
    <div class="grid" id="proj-grid"></div>
  </section>

  <div class="two">
    <section id="sec-inbox">
      <div class="sec-h"><span class="num">3</span><h2>收件箱</h2><span class="count" id="inbox-count"></span></div>
      <div class="card" id="inbox-list"></div>
    </section>
    <section id="sec-nav">
      <div class="sec-h"><span class="num">4</span><h2>知识库</h2><span class="count" id="nav-count"></span></div>
      <input class="search" id="q" placeholder="按标题 / 路径 / 标签筛选…" autocomplete="off" />
      <div class="card" style="padding:14px 16px" id="nav-body"></div>
    </section>
  </div>

  <section id="sec-all">
    <div class="sec-h"><span class="num">5</span><h2>其余待办</h2><span class="count" id="all-count"></span><span class="hint">按笔记分组，点开查看</span></div>
    <div class="card" id="all-list"></div>
  </section>

  <section id="sec-health" style="display:none">
    <div class="sec-h"><span class="num">!</span><h2>书写待规范</h2></div>
    <div class="health" id="health-body"></div>
  </section>

  <footer>
    <span id="gen-at"></span>
    <span>数据来自本地 Obsidian 库，发布时自动生成</span>
  </footer>
</div>

<script id="payload" type="application/json">{"generatedAt":"2026-11-13 18:07","generatedAtLabel":"2026 年 11 月 13 日 · 周五","today":[{"text":"盘欧盟贵金属销售现状","due":"2026-11-13","legacy":false,"sourceTitle":"_index","sourceHref":"../1-Projects/%E6%AC%A7%E7%9B%9FBBC%E8%B4%B5%E9%87%91%E5%B1%9E%E5%8F%8D%E6%B4%97%E9%92%B1%E7%AE%A1%E6%8E%A7/_index","sourceFolder":"1-Projects","overdueDays":0},{"text":"调研欧盟关于贵金属经销商的认定标准和相应义务","due":"2026-11-13","legacy":false,"sourceTitle":"_index","sourceHref":"../1-Projects/%E6%AC%A7%E7%9B%9FBBC%E8%B4%B5%E9%87%91%E5%B1%9E%E5%8F%8D%E6%B4%97%E9%92%B1%E7%AE%A1%E6%8E%A7/_index","sourceFolder":"1-Projects","overdueDays":0}],"restGroups":[{"title":"_index","href":"../1-Projects/%E7%94%9F%E6%88%90LogosCowork%E4%BD%BF%E7%94%A8%E6%8A%A5%E5%91%8A%EF%BC%88%E7%AC%AC2%E9%98%B6%E6%AE%B5%EF%BC%89/_index","folder":"1-Projects","tasks":[{"text":"用AI生成work product \udd3a","due":"2026-11-15","legacy":false,"sourceTitle":"_index","sourceHref":"../1-Projects/%E7%94%9F%E6%88%90LogosCowork%E4%BD%BF%E7%94%A8%E6%8A%A5%E5%91%8A%EF%BC%88%E7%AC%AC2%E9%98%B6%E6%AE%B5%EF%BC%89/_index","sourceFolder":"1-Projects","overdueDays":-2},{"text":"将新旧法差异结论沉淀为法规页（EU-AMLD6-贵金属经销商义务）","due":null,"legacy":false,"sourceTitle":"_index","sourceHref":"../1-Projects/%E5%85%A8%E7%90%83%E8%B4%B5%E9%87%91%E5%B1%9E%E8%B4%B5%E5%AE%9D%E7%9F%B3%E7%8F%A0%E5%AE%9D%E5%8F%8D%E6%B4%97%E9%92%B1%E7%AE%A1%E6%8E%A7/_index","sourceFolder":"1-Projects","overdueDays":null},{"text":"补齐各国阈值口径矩阵并入库","due":null,"legacy":false,"sourceTitle":"_index","sourceHref":"../1-Projects/%E5%85%A8%E7%90%83%E8%B4%B5%E9%87%91%E5%B1%9E%E8%B4%B5%E5%AE%9D%E7%9F%B3%E7%8F%A0%E5%AE%9D%E5%8F%8D%E6%B4%97%E9%92%B1%E7%AE%A1%E6%8E%A7/_index","sourceFolder":"1-Projects","overdueDays":null},{"text":"补充美国各州溢价上限规则","due":null,"legacy":false,"sourceTitle":"_index","sourceHref":"../1-Projects/%E7%BE%8E%E5%9B%BD%E8%B4%B5%E9%87%91%E5%B1%9E%E6%BA%A2%E4%BB%B7%E4%B8%8A%E9%99%90/_index","sourceFolder":"1-Projects","overdueDays":null},{"text":"判断是否需进