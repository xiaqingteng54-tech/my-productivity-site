<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>我的工作台</title>
<style>
:root{
  --paper:#F5F2EA;
  --card:#FFFFFF;
  --ink:#18211E;
  --ink-2:#3E4A45;
  --ink-3:#6F7C75;
  --ink-4:#9CA8A1;
  --line:#E4DFD2;
  --line-2:#EFEBE0;
  --pine:#2C5A4C;
  --pine-soft:#EDF3EF;
  --brass:#A97A3C;
  --brass-soft:#F7F0E3;
  --rust:#9E452C;
  --serif:"Songti SC","STSong","Noto Serif SC","Source Han Serif SC",Georgia,serif;
  --sans:"PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,-apple-system,sans-serif;
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;padding:0 0 60px;background:var(--paper);color:var(--ink);
  font-family:var(--sans);font-size:15px;line-height:1.75;
  -webkit-font-smoothing:antialiased;
  background-image:radial-gradient(1200px 600px at 78% -12%,rgba(169,122,60,.10),transparent 62%),
                   radial-gradient(900px 520px at 4% 2%,rgba(44,90,76,.07),transparent 60%);
  background-attachment:fixed;
}
a{color:inherit;text-decoration:none}
.wrap{max-width:1140px;margin:0 auto;padding:0 32px}

/* ============ 报头 ============ */
.masthead{padding:44px 0 26px;border-bottom:1px solid var(--line)}
.masthead__row{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;flex-wrap:wrap}
.kicker{
  font-size:10.5px;letter-spacing:.26em;color:var(--brass);font-weight:700;margin-bottom:10px;
}
h1{
  font-family:var(--serif);font-size:40px;line-height:1.2;font-weight:700;
  margin:0;letter-spacing:.01em;
}
h1 small{
  display:block;font-family:var(--sans);font-size:12px;font-weight:400;
  letter-spacing:.18em;color:var(--ink-4);margin-top:10px;
}
.datestamp{text-align:right;flex:none}
.datestamp .d1{font-family:var(--serif);font-size:15px;color:var(--ink-2);letter-spacing:.06em}
.datestamp .d2{
  font-family:var(--serif);font-size:34px;font-weight:700;line-height:1.1;
  color:var(--pine);letter-spacing:.02em;font-variant-numeric:tabular-nums;
}
.datestamp .d3{font-size:11px;letter-spacing:.18em;color:var(--ink-4);margin-top:6px}

/* ============ KPI 条 ============ */
.kpi{
  margin:0;padding:0;list-style:none;
  display:grid;grid-template-columns:repeat(5,1fr);
  border-bottom:1px solid var(--line);
}
.kpi li{
  padding:26px 22px 24px;border-right:1px solid var(--line-2);position:relative;
}
.kpi li:last-child{border-right:none}
.kpi .lab{
  font-size:10.5px;letter-spacing:.2em;color:var(--ink-4);font-weight:700;
  display:block;margin-bottom:8px;
}
.kpi .num{
  font-family:var(--serif);font-size:38px;line-height:1;font-weight:700;
  color:var(--ink);font-variant-numeric:tabular-nums;letter-spacing:-.01em;
}
.kpi .num.zero{color:var(--ink-4)}
.kpi .num.alert{color:var(--rust)}
.kpi .sub{font-size:11.5px;color:var(--ink-3);margin-top:8px;letter-spacing:.02em}
.kpi li::after{
  content:"";position:absolute;left:22px;bottom:0;width:26px;height:2px;
  background:var(--brass);opacity:.55;
}

/* ============ 主体两栏 ============ */
.grid{display:grid;grid-template-columns:1.12fr 1fr;gap:34px;padding:38px 0 8px}
@media (max-width:900px){.grid{grid-template-columns:1fr;gap:30px}}

.sec{margin-bottom:34px}
.sec:last-child{margin-bottom:0}
.sec__head{
  display:flex;align-items:baseline;justify-content:space-between;gap:14px;
  padding-bottom:9px;margin-bottom:16px;border-bottom:1px solid var(--ink);
}
.sec__head h2{
  font-family:var(--serif);font-size:18px;font-weight:700;margin:0;letter-spacing:.04em;
  display:flex;align-items:baseline;gap:9px;
}
.sec__head h2 i{
  font-style:normal;font-family:var(--sans);font-size:10px;letter-spacing:.2em;
  color:var(--brass);font-weight:700;
}
.sec__meta{font-size:11.5px;color:var(--ink-4);letter-spacing:.06em;white-space:nowrap}

/* 今日待办 */
.todo{
  display:block;background:var(--card);border:1px solid var(--line);border-radius:3px;
  padding:16px 18px 15px 20px;margin-bottom:10px;position:relative;
  transition:border-color .28s ease,box-shadow .28s ease,transform .28s ease;
}
.todo::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--pine);
  border-radius:3px 0 0 3px;
}
.todo:hover{border-color:#CFC8B6;box-shadow:0 10px 24px -18px rgba(24,33,30,.5);transform:translateY(-2px)}
.todo__t{display:flex;gap:12px;align-items:flex-start}
.todo__n{
  font-family:var(--serif);font-size:11px;color:var(--brass);font-weight:700;
  letter-spacing:.1em;flex:none;padding-top:3px;min-width:18px;
}
.todo__x{font-size:15px;line-height:1.65;color:var(--ink);font-weight:500}
.todo__m{
  margin-top:7px;padding-left:30px;display:flex;flex-wrap:wrap;gap:6px 14px;
  font-size:11.5px;color:var(--ink-4);
}
.todo__m b{color:var(--rust);font-weight:600;letter-spacing:.04em}
.todo__m .src{font-family:var(--mono);font-size:11px;color:var(--ink-3)}

/* 收件箱 */
.inbox{
  display:flex;align-items:center;gap:14px;background:var(--brass-soft);
  border:1px solid #EBDFC8;border-radius:3px;padding:13px 16px;
  transition:border-color .28s ease,transform .28s ease;
}
.inbox:hover{border-color:var(--brass);transform:translateY(-1px)}
.inbox__t{font-size:14px;font-weight:600;color:var(--ink)}
.inbox__m{font-size:11.5px;color:var(--ink-3);margin-left:auto;white-space:nowrap}

/* 项目看板 */
.proj{
  display:block;padding:14px 2px 15px;border-bottom:1px solid var(--line-2);
  transition:background .25s ease;
}
.proj:last-child{border-bottom:none}
.proj:hover{background:rgba(255,255,255,.6)}
.proj__top{display:flex;align-items:baseline;gap:10px;justify-content:space-between}
.proj__t{font-size:14.5px;font-weight:600;color:var(--ink);line-height:1.5}
.proj__st{
  flex:none;font-size:10.5px;letter-spacing:.12em;color:var(--pine);
  background:var(--pine-soft);border-radius:2px;padding:2px 8px;font-weight:700;
}
.bar{
  margin-top:11px;height:3px;background:var(--line-2);border-radius:2px;overflow:hidden;position:relative;
}
.bar span{
  display:block;height:100%;width:0;background:var(--pine);border-radius:2px;
  transition:width 1.1s cubic-bezier(.22,.75,.25,1);
}
.bar.mid span{background:var(--brass)}
.bar.zero span{background:var(--ink-4)}
.proj__m{
  margin-top:8px;display:flex;justify-content:space-between;gap:12px;
  font-size:11.5px;color:var(--ink-4);font-variant-numeric:tabular-nums;
}
.proj__m b{color:var(--ink-2);font-weight:600}

/* ============ 知识库 ============ */
.kbsec{margin-top:44px;padding-top:34px;border-top:1px solid var(--line)}
.kbsec__head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px;flex-wrap:wrap}
.kbsec__head h2{
  font-family:var(--serif);font-size:24px;margin:0;font-weight:700;letter-spacing:.02em;
}
.kbsec__head p{margin:6px 0 0;font-size:12.5px;color:var(--ink-3);letter-spacing:.02em}
.kbsec__head .tot{
  font-family:var(--serif);font-size:13px;color:var(--ink-3);letter-spacing:.04em;
}
.kbsec__head .tot b{font-size:22px;color:var(--pine);font-weight:700;font-variant-numeric:tabular-nums}

.kbgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
@media (max-width:1000px){.kbgrid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:560px){.kbgrid{grid-template-columns:1fr}}

.fold{
  background:var(--card);border:1px solid var(--line);border-radius:3px;padding:18px 18px 16px;
  transition:border-color .28s ease,box-shadow .28s ease,transform .28s ease;
}
.fold:hover{border-color:#CFC8B6;box-shadow:0 14px 30px -22px rgba(24,33,30,.55);transform:translateY(-2px)}
.fold__h{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.fold__n{
  font-family:var(--mono);font-size:12px;color:var(--pine);font-weight:600;letter-spacing:.02em;
}
.fold__c{
  font-family:var(--serif);font-size:12px;color:var(--ink-4);font-variant-numeric:tabular-nums;
}
.fold__c b{color:var(--brass);font-size:15px}
.fold__rule{height:1px;background:var(--line-2);margin:11px 0 10px}
.fold ul{list-style:none;margin:0;padding:0}
.fold li{margin:0 0 7px;display:flex;align-items:baseline;gap:8px}
.fold li:last-child{margin-bottom:0}
.fold li a{
  display:flex;gap:7px;align-items:baseline;font-size:12.8px;line-height:1.6;color:var(--ink-2);
  transition:color .22s ease;flex:1 1 auto;min-width:0;
}
.fold li a:hover{color:var(--pine)}
.fold li a::before{content:"";flex:none;width:3px;height:3px;border-radius:50%;background:var(--ink-4);margin-top:9px}
.fold li a:hover::before{background:var(--brass)}
.fold li .bdg{
  flex:none;margin-left:auto;font-size:10px;color:var(--rust);font-family:var(--mono);
  background:#FBF0EC;border-radius:2px;padding:0 5px;
}
.fold__more{
  display:inline-block;margin-top:12px;font-size:11.5px;color:var(--ink-3);
  border-bottom:1px solid var(--line);padding-bottom:1px;letter-spacing:.04em;
}
.fold__more:hover{color:var(--brass);border-bottom-color:var(--brass)}

/* ============ 页脚 ============ */
.foot{
  margin-top:46px;padding-top:18px;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;
  font-size:11.5px;color:var(--ink-4);letter-spacing:.04em;
}
.foot .note{display:flex;align-items:center;gap:7px}
.foot .note i{width:5px;height:5px;border-radius:50%;background:var(--brass);flex:none}
.foot .mono{font-family:var(--mono);font-size:11px;letter-spacing:0}

/* 入场 */
.rise{opacity:0;transform:translateY(10px);animation:rise .7s cubic-bezier(.22,.75,.25,1) forwards}
@keyframes rise{to{opacity:1;transform:none}}
.d1{animation-delay:.04s}.d2{animation-delay:.1s}.d3{animation-delay:.16s}
.d4{animation-delay:.22s}.d5{animation-delay:.28s}.d6{animation-delay:.34s}

@media (max-width:720px){
  .wrap{padding:0 18px}
  h1{font-size:29px}
  .datestamp{text-align:left}
  .datestamp .d2{font-size:26px}
  .kpi{grid-template-columns:repeat(2,1fr)}
  .kpi li{padding:18px 14px}
  .kpi li:nth-child(2n){border-right:none}
  .kpi .num{font-size:30px}
  .kpi li::after{left:14px}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  .rise{opacity:1;transform:none}
}
@media print{
  @page{size:A4;margin:16mm 14mm}
  body{background:#fff;background-image:none;font-size:10pt;padding:0}
  .wrap{max-width:none;padding:0}
  .rise{opacity:1;animation:none;transform:none}
  .todo,.fold,.proj,.inbox,.kpi li{break-inside:avoid}
  .todo:hover,.fold:hover{transform:none;box-shadow:none}
  .sec,.kbsec{break-inside:avoid}
  .bar span{transition:none}
}
</style>
</head>
